# Copy this file to .env and adjust it:   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored — never commit it.

# Public domain served by Caddy, e.g. myinvoice.duckdns.org (HTTPS certificate is automatic).
# "localhost" runs the full stack locally with Caddy's own certificate authority.
DOMAIN=localhost

# Port the app listens on inside its container. Keep 8000 with compose.yml (Caddy proxies to app:8000);
# Cloud Run sets PORT itself.
PORT=8000

# Pagination of the PDF: rows per table (1–30) and tables per page (1–2).
ROWS_PER_TABLE=20
TABLES_PER_PAGE=2

# Maximum number of items in one invoice.
MAX_ITEMS=1000

# PDF requests allowed per client IP per minute.
RATE_LIMIT_PER_MINUTE=10

# PDFs rendered at the same time; a request waits up to ~10 s for a free slot, then gets 503.
MAX_CONCURRENT_RENDERS=2

# Expose the interactive API docs at /docs (development only).
ENABLE_API_DOCS=false

# Optional HTTP Basic Auth for the whole site (any username, this password). Empty = no password.
APP_PASSWORD=

# critical | error | warning | info | debug
LOG_LEVEL=info
